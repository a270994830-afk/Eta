    <!-- Settings: local MCP Server section -->
    <string name="mcp_server_section_title">Local MCP Server (let external clients drive Eta)</string>
    <string name="mcp_server_section_summary">Expose Eta\'s toolset over the MCP Streamable HTTP protocol so clients such as Claude Desktop, Cursor, OpenCode or Continue can call Eta to control this phone.</string>
    <string name="mcp_server_enable_label">Enable local MCP Server</string>
    <string name="mcp_server_enable_summary">Eta listens on a 127.0.0.1 port; external clients authenticate with a Bearer token and can then use the toolset.</string>
    <string name="mcp_server_port_label">Listen port</string>
    <string name="mcp_server_port_summary">An integer between 1024 and 65535; clients must know this port to connect.</string>
    <string name="mcp_server_token_label">Bearer Token</string>
    <string name="mcp_server_token_summary">Secret sent in the client\'s Authorization header; 32+ characters recommended. Leave empty to auto-generate.</string>
    <string name="mcp_server_token_placeholder">Auto-generated (filled when you press Start)</string>
    <string name="mcp_server_allow_sensitive_label">Expose sensitive tools</string>
    <string name="mcp_server_allow_sensitive_summary">Off by default. When enabled, clients may call sensitive tools such as reading notifications or personal orders.</string>
